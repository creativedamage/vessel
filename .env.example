# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://vessel:vessel@localhost:5432/vessel
# Used by the API test suite (wiped and re-migrated on each run)
TEST_DATABASE_URL=postgresql://vessel:vessel@localhost:5432/vessel_test

# ── API ─────────────────────────────────────────────────────
API_PORT=4000
# Public URL of the web app (OIDC redirects land here, then proxy to the API)
WEB_ORIGIN=http://localhost:3000
# 32+ random bytes, base64. `openssl rand -base64 32`
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Lets you sign in as any seeded staff email without SSO. NEVER enable in production.
AUTH_DEV_LOGIN=true

# ── Microsoft Entra ID (optional) ───────────────────────────
# App registration → Web redirect URI: {WEB_ORIGIN}/api/v1/auth/oidc/entra/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── Google Workspace (optional) ─────────────────────────────
# OAuth client (Web) → redirect URI: {WEB_ORIGIN}/api/v1/auth/oidc/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict sign-in to this Workspace domain (hd claim)
GOOGLE_HOSTED_DOMAIN=

# ── Web ─────────────────────────────────────────────────────
# Where the Next.js server proxies /api/* to
API_INTERNAL_URL=http://localhost:4000
